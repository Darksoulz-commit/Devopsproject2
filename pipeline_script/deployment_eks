pipeline {
    agent any

    parameters {
        string(
            name: 'AWS_REGION',
            defaultValue: 'ap-south-1',
            description: 'Enter your AWS region'
        )

        string(
            name: 'AWS_ACCOUNT_ID',
            defaultValue: '050670421700',
            description: 'Enter your AWS account ID'
        )

        string(
            name: 'ECR_REPO_NAME',
            defaultValue: 'amazon-prime',
            description: 'Enter ECR repository name'
        )

        string(
            name: 'VERSION',
            defaultValue: 'latest',
            description: 'Enter Docker image version'
        )

        string(
            name: 'CLUSTER_NAME',
            defaultValue: 'devops-project-cluster',
            description: 'Enter your EKS cluster name'
        )
    }

    environment {
        AWS_DEFAULT_REGION = "${params.AWS_REGION}"
    }

    stages {

        // 1. Clone GitHub Repository
        stage('1. Clone GitHub Repository') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Darksoulz-commit/Devopsproject2.git'
            }
        }

        // 2. Login to AWS and Connect to EKS
        stage('2. Login to EKS') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'access-key',
                        variable: 'AWS_ACCESS_KEY_ID'
                    ),
                    string(
                        credentialsId: 'secret-key',
                        variable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    sh '''
                        echo "Checking AWS Identity..."

                        aws sts get-caller-identity

                        echo "Updating EKS kubeconfig..."

                        aws eks update-kubeconfig \
                            --region "$AWS_REGION" \
                            --name "$CLUSTER_NAME"

                        echo "Checking Kubernetes connection..."

                        kubectl get nodes
                    '''
                }
            }
        }

        // 3. Select Docker Image Version
        stage('3. Select Image Version') {
            steps {
                script {
                    env.ECR_IMAGE_NAME =
                        "${params.AWS_ACCOUNT_ID}.dkr.ecr.${params.AWS_REGION}.amazonaws.com/${params.ECR_REPO_NAME}:${params.VERSION}"

                    echo "Selected Docker Image: ${env.ECR_IMAGE_NAME}"

                    sh '''
                        echo "Checking deployment YAML..."

                        test -f k8s_files/deployment.yaml

                        sed -i -E \
                        "s|^([[:space:]]*image:[[:space:]]*).*$|\\1${ECR_IMAGE_NAME}|" \
                        k8s_files/deployment.yaml

                        echo "Updated image in deployment.yaml"

                        grep -n 'image:' k8s_files/deployment.yaml
                    '''
                }
            }
        }

        // 4. Verify Docker Image in ECR
        stage('4. Verify ECR Image') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'access-key',
                        variable: 'AWS_ACCESS_KEY_ID'
                    ),
                    string(
                        credentialsId: 'secret-key',
                        variable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    sh '''
                        aws ecr describe-images \
                            --repository-name "$ECR_REPO_NAME" \
                            --image-ids imageTag="$VERSION" \
                            --region "$AWS_REGION"
                    '''
                }
            }
        }

        // 5. Deploy Application to EKS
        stage('5. Deploy to EKS') {
            steps {
                sh '''
                    echo "Deploying application..."

                    kubectl apply -f k8s_files/deployment.yaml

                    kubectl apply -f k8s_files/service.yaml

                    echo "Deployment submitted successfully."
                '''
            }
        }

        // 6. Verify Kubernetes Deployment
        stage('6. Verify Deployment') {
            steps {
                sh '''
                    echo "Checking Kubernetes deployments..."

                    kubectl get deployments

                    echo "Checking pods..."

                    kubectl get pods

                    echo "Checking services..."

                    kubectl get services
                '''
            }
        }
    }

    post {
        success {
            echo 'Application successfully deployed to AWS EKS!'
        }

        failure {
            echo 'EKS deployment failed. Check the Jenkins console output.'
        }

        always {
            echo 'EKS deployment pipeline execution completed.'
        }
    }
}
